---
title: Studio Satsuma
scripts: [tree]
hideFooter: true
---
<main class="home">
  <header class="hero">
    <h1><span class="studio">Studio</span> Satsuma</h1>
    <p class="tagline">Small apps, grown in Brooklyn.</p>
  </header>

  <section class="stage" aria-label="The satsuma tree">
    {% include "tree.njk" %}
  </section>

  {#- The roster: the canonical list for screen readers, search engines and
      no-JS visitors. Not shown; the tree is the visible roster. #}
  <section class="projects visually-hidden" aria-labelledby="projects-heading">
    <h2 id="projects-heading">Projects</h2>
    <ul>
      {% for project in collections.projects %}
      <li>
        {% if project.data.icon %}<img class="project-icon" src="{{ project.data.icon }}" alt="" width="40" height="40">{% endif %}
        <span class="name">{% if project.url %}<a href="{{ project.url }}" tabindex="-1">{{ project.data.title }}</a>{% else %}{{ project.data.title }}{% endif %}</span>
        <span class="status" data-status="{{ project.data.status }}">{{ project.data.status | statusWord }}</span>
        <span class="one-line">{{ project.data.oneLine }}</span>
      </li>
      {% endfor %}
    </ul>
  </section>

  <p class="services">
    Shipped a prototype with AI and hit the wall? We make it scale, and help you
    build the team that keeps it that way.
    <a href="mailto:{{ site.email }}">{{ site.email }}</a>
  </p>
</main>
