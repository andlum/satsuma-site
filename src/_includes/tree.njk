{#
  The satsuma tree. One fruit per project in `collections.projects`, placed at
  the project's `slot`; fruit type follows status (live = ripe, in-progress =
  "green": a smaller orange fruit that can't be picked yet, coming-soon =
  blossom). Growth, picking and cards live in
  src/js/tree.js, which reads everything it needs from this markup.

  The static drawing (ground, trunk, branches, canopy) is tree-art.njk,
  written by scripts/draw-tree.js; the fruit loop and the card are
  hand-written below it. Wind (src/js/wind.js) moves the leaves, the fruit
  and the tufts.
#}
{#- One citrus fruit, radius 14, hanging from (0, 0). Cel-shaded: flat skin,
    a hard shadow on the lower right, a bounce light inside it, a hard
    highlight on the upper left. Colours come from .ripe / .green. #}
{% macro citrus() %}
              <ellipse class="skin" cy="14" rx="14.5" ry="13.6"/>
              <path class="shade" d="M13.6 9.4 A14.5 13.6 0 0 1 -9.8 24 A16.5 16.5 0 0 0 13.6 9.4Z"/>
              <path class="bounce" d="M11.6 16.5 A12 11.2 0 0 1 4.2 24.6"/>
              <ellipse class="shine" cx="-5.6" cy="7.6" rx="4.8" ry="2.7" transform="rotate(-35 -5.6 7.6)"/>
              <circle class="shine" cx="-10" cy="13.4" r="1.2"/>
              <path class="pores" d="M2 18h.01M6.5 13h.01M-3 22.5h.01M-6 17h.01"/>
              <path class="calyx" d="M0 -2.2 L1.3 .2 L4 .6 L1.900 2.2 L2.400 4.8 L0 3.5 L-2.400 4.8 L-1.900 2.2 L-4 .6 L-1.3 .2Z"/>
              <path class="fleaf" d="M0 1 C3 -6 10 -8 14 -5 C10 -3 5 -1 0 1Z"/>
              <path class="fleaf deep" d="M0 1 C-2 -5 -8 -8 -12 -6 C-7 -4 -3 -2 0 1Z"/>
{%- endmacro %}
{% set anchors = [
  [200, 118], [138, 146], [262, 146], [96, 206], [304, 206], [200, 186],
  [152, 250], [248, 250], [92, 286], [308, 286], [168, 328], [236, 328]
] %}
{% set kinds = { "live": "ripe", "in-progress": "green", "coming-soon": "blossom" } %}
<div class="tree">
  <svg viewBox="0 0 400 500" role="img" aria-label="{{ collections.projects | treeLabel }}">
    {% include "tree-art.njk" %}
    <g class="fruits">
      {%- for project in collections.projects %}
      {%- set p = project.data %}
      {%- set kind = kinds[p.status] %}
      {%- set anchor = anchors[p.slot - 1] %}
      <g class="slot" transform="translate({{ anchor[0] }} {{ anchor[1] }})">
        <g class="fruit {{ kind }}" data-slug="{{ p.slug }}" data-status="{{ p.status | statusWord | lower }}" data-name="{{ p.title }}" style="--i:{{ loop.index0 }}">
          {%- if kind == "ripe" %}
          <path class="stem" d="M0 0 L0 12"/>
          <g class="body" transform="translate(0 12)">
            <g class="sway">
              {{ citrus() }}
              <g transform="translate(12 2)"><path class="glint" d="M0 -6 Q.7 -.7 6 0 Q.7 .7 0 6 Q-.7 .7 -6 0 Q-.7 -.7 0 -6Z"/></g>
            </g>
          </g>
          {%- elif kind == "green" %}
          <path class="stem" d="M0 0 L0 10"/>
          <g class="body" transform="translate(0 10)">
            <g class="sway">
              <g transform="scale(.82)">{#- smaller than a ripe one #}
              {{ citrus() }}
              </g>
            </g>
          </g>
          {%- else %}
          <path class="stem" d="M0 0 L0 8"/>
          <g class="body" transform="translate(0 8)">
            <g class="sway">
              <g class="petal-shadow" transform="translate(1.2 9.5)">
                <circle cy="-5.5" r="5"/><circle cx="5.2" cy="-1.7" r="5"/><circle cx="3.2" cy="4.5" r="5"/>
                <circle cx="-3.2" cy="4.5" r="5"/><circle cx="-5.2" cy="-1.7" r="5"/>
              </g>
              <g class="petal" transform="translate(0 8)">
                <circle cy="-5.5" r="5"/><circle cx="5.2" cy="-1.7" r="5"/><circle cx="3.2" cy="4.5" r="5"/>
                <circle cx="-3.2" cy="4.5" r="5"/><circle cx="-5.2" cy="-1.7" r="5"/>
              </g>
              <g class="stamen" transform="translate(0 8)">
                <circle cy="-3.8" r=".9"/><circle cx="3.6" cy="-1.2" r=".9"/><circle cx="2.2" cy="3.1" r=".9"/>
                <circle cx="-2.2" cy="3.1" r=".9"/><circle cx="-3.6" cy="-1.2" r=".9"/>
              </g>
              <circle class="eye" cy="8" r="2.2"/>
            </g>
          </g>
          {%- endif %}
        </g>
      </g>
      {%- endfor %}
    </g>
    {#- "Pick me": an arrow from below the canopy to the first ripe fruit.
        tree.js hides it once a fruit has been picked. #}
    {%- set live = [] %}
    {%- for project in collections.projects %}{% if project.data.status == "live" %}{% set _ = live.push(anchors[project.data.slot - 1]) %}{% endif %}{% endfor %}
    {%- if live.length %}
    {%- set a = live[0] %}
    {%- set d = -1 if a[0] < 200 else 1 %}
    {%- set ex = a[0] + d * 14 %}{% set ey = a[1] + 43 %}
    {%- set sx = a[0] + d * 34 %}{% set sy = 380 %}
    <g class="pick" aria-hidden="true">
      <path class="pick-halo" pathLength="1" d="M{{ sx }} {{ sy }} C{{ sx + d * 12 }} {{ sy - (sy - ey) * 0.39 }} {{ ex + d * 24 }} {{ ey + 19 }} {{ ex }} {{ ey }}"/>
      <path class="pick-line" pathLength="1" d="M{{ sx }} {{ sy }} C{{ sx + d * 12 }} {{ sy - (sy - ey) * 0.39 }} {{ ex + d * 24 }} {{ ey + 19 }} {{ ex }} {{ ey }}"/>
      <path class="pick-head" d="M-7 -5 L0 0 L-7 5" transform="translate({{ ex }} {{ ey }}) rotate({{ -38 if d < 0 else -142 }})"/>
      <text class="pick-text" x="{{ a[0] + d * 60 }}" y="402" text-anchor="middle">Pick me</text>
    </g>
    {%- endif %}
  </svg>
  <dialog class="card" aria-labelledby="card-title">
    <svg class="card-fruit" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="17" r="12"/><path d="M16 5c2-3 5-3 6-2-2 0-4 1-6 2z"/></svg>
    <div class="card-body"></div>
    <button class="close" type="button" aria-label="Close">&times;</button>
  </dialog>
  <div class="tip" role="status" hidden></div>

  {#- Card contents, one per ripe fruit. tree.js clones the template whose
      data-slug matches the picked fruit. #}
  {%- for project in collections.projects %}
  {%- if project.data.status == "live" %}
  <template data-slug="{{ project.data.slug }}">
    <h2>{{ project.data.title }}</h2>
    <p class="card-status"><span class="status" data-status="{{ project.data.status }}">{{ project.data.status | statusWord }}</span></p>
    <p>{{ project.data.oneLine }}</p>
    {%- if project.url or (project.data.links and project.data.links.length) %}
    <p class="links">
      {%- if project.url %}<a href="{{ project.url }}">Project page</a>{% endif %}
      {%- for link in project.data.links %}<a href="{{ link.url }}">{{ link.label }}</a>{% endfor %}
    </p>
    {%- endif %}
  </template>
  {%- endif %}
  {%- endfor %}
</div>
